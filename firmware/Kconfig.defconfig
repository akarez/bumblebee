if BOARD_BUMBLEBEE

config BOARD
    default "bumblebee"

if USB_DEVICE_STACK

config USB_NRFX
    default y

config USB_DEVICE_STACK
    default y

endif # USB

config BT_CTLR
    default BT

endif # BOARD_BUMBLEBEE